#include<iostream>
using namespace std;

int main() {
    int data[] = {9, 12, 0, 78, 4, 90, 8, 90, 9, 89, 4, 83, 0, 19, 7, 
                  100, 0, 98, 2, 88, 0, 91, 9, 0, 23, 1, 84, 83, 
                  0, 19, 84, 8, 20, 8, 0, 93, 0, 92, 83, 20, 47, 
                  11, 18, 99, 83, 74, 84, 92, 13, 0, 83, 44, 78, 
                  83, 41, 23, 87, 23, 1, 19, -1};

    // 1. تصحيح: تعريف المتغيرات وإعطاؤها قيمة صفر
    int ctr = 0, even = 0, odd = 0, zero = 0;

    // 2. تصحيح: فحص العنصر الحالي في المصفوفة
    while (data[ctr] != -1) {
        if (data[ctr] == 0) {
            zero++;
        } else if (data[ctr] % 2 == 0) {
            even++;
        } else {
            odd++;
        }
        
        // 3. تصحيح: زيادة العداد للانتقال للرقم التالي
        ctr++;
    }

    cout << "Even numbers: " << even << endl;
    cout << "Odd numbers: " << odd << endl;
    cout << "Zero: " << zero << endl;

    return 0;
}

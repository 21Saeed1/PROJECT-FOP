#include <iostream>
using namespace std;

int main() {
    int n;

    // طلب حجم المصفوفة
    cout << "Enter Number of Elements in the Array: ";
    cin >> n;

    // التأكد من أن الحجم ضمن النطاق المطلوب (5-100)
    if (n < 5 || n > 100) {
        cout << "Error: Size must be between 5 and 100." << endl;
        return 1;
    }

    int inputArray[n];
    cout << "Enter " << n << " integer values:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> inputArray[i];
    }

    // تهيئة القيم العظمى والصغرى بأول عنصر
    int max = inputArray[0];
    int min = inputArray[0];
    int maxIndex = 0;
    int minIndex = 0;

    // البحث عن أكبر وأصغر عنصر
    for (int i = 1; i < n; i++) {
        if (inputArray[i] > max) {
            max = inputArray[i];
            maxIndex = i;
        }
        if (inputArray[i] < min) {
            min = inputArray[i];
            minIndex = i;
        }
    }

    // طباعة النتائج النهائية
    cout << "Maximum Element: " << max << " found at index " << maxIndex << endl;
    cout << "Minimum Element: " << min << " found at index " << minIndex << endl;

    return 0;
}

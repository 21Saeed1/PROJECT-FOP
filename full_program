// Function to assign a Course.
void assignCourse() {
    int sId, cId;
    cout << "Enter Student ID: ";
    cin >> sId;
    cout << "Enter Course ID to assign: ";
    cin >> cId;

    int sIndex = -1, cIndex = -1;
    for (int i = 0; i < number_of_student; i++)
    {
        if (listOfStudent[i].Student_id == sId){
            sIndex = i;
            break;
        }
    }
    for (int i = 0; i < number_of_courses; i++) {
        if (courses[i].courseId == cId) {
            cIndex = i; break; }
    }

    if (sIndex != -1 && cIndex != -1) {
        if (listOfStudent[sIndex].coursesCount < 10) {
            listOfStudent[sIndex].registeredCourses[listOfStudent[sIndex].coursesCount] = cId;
            listOfStudent[sIndex].coursesCount++;
            cout << "Course assigned successfully!\n";
        } else {
            cout << "Student reached maximum course limit.\n";
                }
    }
    else { cout << "Student or Course not found!\n"; }

    cout << "Press 0 to exit or any number to go back: ";
    int input;
    cin >> input;
    if (input == 0)
        program = false;
}


// Function to remove courese from student.
void removeCourse() {
    int sId, cId;
    cout << "Enter Student ID: ";
    cin >> sId;
    cout << "Enter Course ID to remove: ";
    cin >> cId;

    for (int i = 0; i < number_of_student; i++) {
        if (listOfStudent[i].Student_id == sId) {
            for (int j = 0; j < listOfStudent[i].coursesCount; j++) {
                if (listOfStudent[i].registeredCourses[j] == cId) {
                    for (int k = j; k < listOfStudent[i].coursesCount - 1; k++) {
                        listOfStudent[i].registeredCourses[k] = listOfStudent[i].registeredCourses[k + 1];
                    }
                    listOfStudent[i].coursesCount--;
                    cout << "Course removed successfully!\n";
                    cout << "Press 0 to exit or any number to go back: ";
                    int input;
                    cin >> input;
                    if (input == 0)
                        program = false;
                    return;
                }
            }
        }
    }
    cout << "Record not found!\n";
}



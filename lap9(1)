#include <iostream>
#include <string>
using namespace std;

struct Sentence {
    string Text;
    int Alphabet;
    int Digit;
    int SpecialChar; // تصحيح الإملاء هنا
};

// إضافة & للتعديل على القيمة الأصلية
void CountChar(Sentence &S); 
void Print(Sentence S);

int main() {
    string Str;
    Sentence S1 = {"", 0, 0, 0};
    cout << "Enter a String: ";
    getline(cin, Str);
    S1.Text = Str;

    CountChar(S1);
    Print(S1);

    return 0;
}

void CountChar(Sentence &S) {
    int i = 0;
    char ch;
    while (i < S.Text.length()) { // تصحيح علامة <
        ch = S.Text.at(i);
        if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) {
            S.Alphabet++;
        } else if (ch >= '0' && ch <= '9') { // تصحيح شرط الأرقام
            S.Digit++;
        } else {
            S.SpecialChar++; // تصحيح العملية إلى ++
        }
        i++;
    }
}

void Print(Sentence S) {
    cout << "Inserted Text is: " << S.Text << endl;
    cout << "Number of Alphabets = " << S.Alphabet << endl;
    cout << "Number of Digits = " << S.Digit << endl;
    cout << "Number of Special Characters = " << S.SpecialChar << endl;
    cout << "Total Number of characters = " << S.Text.length() << endl;
}

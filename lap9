#include <iostream>
#include <string>

using namespace std;

// تعريف الهيكل لتخزين أجزاء الاسم
struct Person {
    string FirstName;
    string FatherName;
    string GrandFatherName;
    string FamilyName;
};

// تعريف الدوال (Prototypes)
void split(string str, Person *Ptr);
void Print(Person person);

int main() {
    string FullName;
    Person P1;

    cout << "Enter Full Name: ";
    getline(cin, FullName);

    // استدعاء دالة التقسيم وتمرير عنوان المتغير P1 باستخدام &
    split(FullName, &P1);

    // طباعة النتائج
    Print(P1);

    return 0;
}

// دالة تقسيم النص باستخدام المؤشرات (Pointers)
void split(string str, Person *Ptr) {
    int Index = 0;
    int select = 1;

    // حلقة تكرار تبحث عن المسافات وتقص الكلمات
    while (str.find(" ") != string::npos && select <= 4) {
        Index = str.find(" ");
        
        switch (select) {
            case 1:
                Ptr->FirstName = str.substr(0, Index);
                break;
            case 2:
                Ptr->FatherName = str.substr(0, Index);
                break;
            case 3:
                Ptr->GrandFatherName = str.substr(0, Index);
                break;
            case 4:
                Ptr->FamilyName = str.substr(0, Index);
                break;
        }
        
        select++;
        str.erase(0, Index + 1); // حذف الجزء المقطوع من النص
        Index = 0;
    }

    // إضافة الكلمة الأخيرة المتبقية في النص إلى اسم العائلة
    if (!str.empty() && select <= 4) {
        Ptr->FamilyName = str;
    }
}

// دالة الطباعة
void Print(Person person) {
    cout << "First Name : " << person.FirstName << endl;
    cout << "Father Name : " << person.FatherName << endl;
    cout << "Grandfather Name : " << person.GrandFatherName << endl;
    cout << "Family Name : " << person.FamilyName << endl;
}
